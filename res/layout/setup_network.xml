<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ameos_sky_canvas"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="56dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <!-- 96dp 3D Blue Wi-Fi Hero Icon (Figma 4:1222) -->
    <ImageView
        android:id="@+id/wifi_hero_icon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/ameos_wifi_hero" />

    <!-- Title: Connect to a network (#203A51) -->
    <TextView
        android:id="@+id/wifi_page_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="-0.02"
        android:text="Connect to a network"
        android:textColor="#203A51"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wifi_page_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Select a Wi-Fi network to connect to the internet"
        android:textColor="#5B7894"
        android:textSize="14sp" />

    <!-- #F7FCFF 29dp-radius Frosted Card displaying live Wi-Fi networks -->
    <LinearLayout
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:layout_weight="1"
        android:background="@drawable/ameos_frosted_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/wifi_status_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="AVAILABLE NETWORKS"
                android:textColor="#5B7894"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wifi_open_system_picker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:padding="4dp"
                android:text="All Wi-Fi Settings ›"
                android:textColor="#017CFE"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/wifi_network_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- Bottom Action Bar: 44dp circular back button + center/right pill button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="52dp">

        <ImageButton
            android:id="@+id/wifi_back_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/ameos_btn_back_circle"
            android:contentDescription="Back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left_24dp"
            android:tint="#203A51" />

        <Button
            android:id="@+id/wifi_continue_button"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:layout_centerInParent="true"
            android:background="@drawable/ameos_btn_pill_outline"
            android:fontFamily="sans-serif-medium"
            android:text="Continue without Wi-Fi"
            android:textAllCaps="false"
            android:textColor="#203A51"
            android:textSize="14.5sp"
            android:textStyle="bold" />
    </RelativeLayout>

</LinearLayout>
