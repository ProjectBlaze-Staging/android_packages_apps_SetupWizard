<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ameos_sky_canvas"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="40dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <!-- 5-Page Showcase Progress Bars Row (Visible only in Stage 3: Figma 4:1381..4:1486) -->
    <LinearLayout
        android:id="@+id/showcase_progress_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:id="@+id/showcase_bar_0"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#FF60A5FF" />

        <View
            android:id="@+id/showcase_bar_1"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#44FFFFFF" />

        <View
            android:id="@+id/showcase_bar_2"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#44FFFFFF" />

        <View
            android:id="@+id/showcase_bar_3"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="#44FFFFFF" />

        <View
            android:id="@+id/showcase_bar_4"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="#44FFFFFF" />
    </LinearLayout>

    <!-- Header Title & Subtitle -->
    <TextView
        android:id="@+id/theme_page_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="-0.02"
        android:text="Choose your theme"
        android:textColor="#203A51"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/theme_page_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="Personalize your lock screen, glass depth, and atmosphere"
        android:textColor="#5B7894"
        android:textSize="14sp" />

    <!-- Live Interactive Preview Canvas (3-phone carousel / 4x2 icon banner / Showcase artwork) -->
    <org.lineageos.setupwizard.widget.OobeLivePreviewView
        android:id="@+id/oobe_live_preview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1" />

    <!-- STAGE 1 CONTROLS: 3-Phone Theme Carousel Selector (Figma 4:1595) -->
    <LinearLayout
        android:id="@+id/stage_theme_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- 73x24dp Cyan-Blue Pagination Pill -->
        <LinearLayout
            android:layout_width="86dp"
            android:layout_height="26dp"
            android:background="@drawable/ameos_btn_pill_outline"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/theme_dot_0"
                android:layout_width="18dp"
                android:layout_height="8dp"
                android:layout_margin="3dp"
                android:background="#FF02C9FF" />

            <View
                android:id="@+id/theme_dot_1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_margin="3dp"
                android:background="#6660A5FF" />

            <View
                android:id="@+id/theme_dot_2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_margin="3dp"
                android:background="#6660A5FF" />
        </LinearLayout>

        <!-- 3 Preset Theme Chips (sky 1, sky 3, sky 4) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_sky_1"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/ameos_btn_pill_filled"
                android:text="Blaze Light"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp" />

            <Button
                android:id="@+id/btn_sky_3"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/ameos_btn_pill_outline"
                android:text="Blaze Dark"
                android:textAllCaps="false"
                android:textColor="#203A51"
                android:textSize="12.5sp" />

            <Button
                android:id="@+id/btn_sky_4"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/ameos_btn_pill_outline"
                android:text="Dynamic Monet"
                android:textAllCaps="false"
                android:textColor="#203A51"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- STAGE 2 CONTROLS: 3-Column Real Icon Style Selector (BlazeIcons, Classic, Adaptive) -->
    <LinearLayout
        android:id="@+id/stage_icon_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/ameos_frosted_card"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="SELECT ICON ARCHITECTURE"
            android:textColor="#5B7894"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Column 1: BlazeIcons (Modern) -->
            <LinearLayout
                android:id="@+id/icon_style_dimensional"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_oobe_icon_blaze" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="BlazeIcons"
                    android:textColor="#203A51"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Modern"
                    android:textColor="#5B7894"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Column 2: Classic (Lineage Stock) -->
            <LinearLayout
                android:id="@+id/icon_style_classic"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_oobe_icon_classic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="Classic"
                    android:textColor="#203A51"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Lineage Stock"
                    android:textColor="#5B7894"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Column 3: Adaptive (Material You) -->
            <LinearLayout
                android:id="@+id/icon_style_adaptive"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_oobe_icon_adaptive" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="Adaptive"
                    android:textColor="#203A51"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Material You"
                    android:textColor="#5B7894"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Navigation Footer -->
    <RelativeLayout
        android:id="@+id/theme_footer_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp">

        <ImageButton
            android:id="@+id/theme_back_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/ameos_btn_back_circle"
            android:contentDescription="Back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left_24dp"
            android:tint="#203A51" />

        <Button
            android:id="@+id/theme_next_button"
            android:layout_width="184dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/ameos_btn_pill_filled"
            android:fontFamily="sans-serif-medium"
            android:text="Apply This Theme"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </RelativeLayout>

</LinearLayout>
