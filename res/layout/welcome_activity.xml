<org.lineageos.setupwizard.widget.TouchRippleLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Figma 4:1190 Full-bleed dark-to-violet gradient (#000000 26.08% -> #A50AFF 99.76%) -->
    <org.lineageos.setupwizard.widget.LuminousBloomView
        android:id="@+id/luminous_bloom_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Main Welcome Content Column (Figma 4:1190 exact layout) -->
    <LinearLayout
        android:id="@+id/welcome_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="58dp"
        android:paddingEnd="28dp"
        android:paddingBottom="34dp">

        <!-- Figma 4:2489 Blaze Logo (170x48dp) floating directly on pure black top area (NO squircle box, NO black background rectangle!) -->
        <ImageView
            android:id="@+id/brand_logo"
            android:layout_width="176dp"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:clickable="true"
            android:contentDescription="BlazeAOSP"
            android:focusable="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ameos_blaze_logo" />

        <!-- Subtle language selector pill tucked cleanly under the top area or invisible if untouched -->
        <LinearLayout
            android:id="@+id/language_selector_card"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginTop="14dp"
            android:alpha="0.72"
            android:background="@android:color/transparent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_locale"
                android:tint="#99FFFFFF" />

            <TextView
                android:id="@+id/current_locale_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="sans-serif"
                android:text="English (United States)"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="▾"
                android:textColor="#9978CBFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Large open space in the middle matching Figma 4:1190 (no Welcome to Blaze text block!) -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.0" />

        <!-- Figma 4:1219: 88x88dp circular glass upward-arrow start button (bottom=188dp) -->
        <Button
            android:id="@+id/start"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginBottom="46dp"
            android:background="@drawable/ameos_welcome_arrow_btn"
            android:contentDescription="@string/start"
            android:elevation="2dp"
            android:stateListAnimator="@null"
            android:text="" />

        <!-- Figma 4:1212: Accessibility row (stacked vertically above Emergency call, with human icon & #78CBFF wavy underline) -->
        <LinearLayout
            android:id="@+id/accessibility_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_oobe_accessibility_human" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/accessibility_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.82"
                    android:fontFamily="sans-serif"
                    android:text="Accessibility"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="90dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_oobe_wavy_underline" />
            </LinearLayout>
        </LinearLayout>

        <!-- Figma 4:1216: Emergency call row (stacked vertically below Accessibility, with diamond icon & #78CBFF wavy underline) -->
        <LinearLayout
            android:id="@+id/emerg_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_oobe_emergency_diamond" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/emerg_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.82"
                    android:fontFamily="sans-serif"
                    android:text="Emergency call"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <ImageView
                    android:layout_width="106dp"
                    android:layout_height="5dp"
                    android:layout_marginTop="1dp"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/ic_oobe_wavy_underline" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Rising Light Sky Transition Sheet (Figma 4:1220 -> 4:1221) -->
    <View
        android:id="@+id/sky_transition_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@drawable/ameos_sky_transition_sheet_bg"
        android:elevation="16dp"
        android:visibility="gone" />

</org.lineageos.setupwizard.widget.TouchRippleLayout>
