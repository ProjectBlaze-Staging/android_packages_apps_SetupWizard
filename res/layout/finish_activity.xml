<org.lineageos.setupwizard.widget.TouchRippleLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020408">

    <!-- Dark Radial Cosmos Backdrop (Figma 4:1514) -->
    <org.lineageos.setupwizard.widget.LuminousBloomView
        android:id="@+id/finish_bloom_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/finish_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="56dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <!-- Top Blaze Logo (Figma 4:1537 top=110dp) -->
        <ImageView
            android:layout_width="136dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:contentDescription="BlazeAOSP"
            android:scaleType="fitCenter"
            android:src="@drawable/ameos_blaze_logo" />

        <!-- Headline: You're ready! ABOVE the 3D Phone Centerpiece (Figma 4:1520 top=calc(50%-271px)) -->
        <TextView
            android:id="@+id/finish_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:text="You’re ready!"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Subtitle (Figma 4:1522) -->
        <TextView
            android:id="@+id/finish_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="Welcome to BlazeAOSP. Your device is configured and ready for 120Hz fluidity."
            android:textColor="#D9FFFFFF"
            android:textSize="15.5sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5" />

        <!-- 12-Point Blue Star (Star 34) + 3D Phone Centerpiece in the center (Figma 4:1525) -->
        <FrameLayout
            android:id="@+id/finish_hero_stage"
            android:layout_width="295dp"
            android:layout_height="315dp"
            android:gravity="center">

            <ImageView
                android:id="@+id/finish_star_bg"
                android:layout_width="285dp"
                android:layout_height="285dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ameos_star_34" />

            <ImageView
                android:id="@+id/brand_logo"
                android:layout_width="230dp"
                android:layout_height="305dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ameos_finish_phone" />
        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.7" />

        <!-- Figma 4:1517: Wide 345dp Glowing #60A5FF -> #4781FF Get Started Pill Button -->
        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/ameos_btn_pill_filled"
            android:elevation="8dp"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="Get Started"
            android:textAllCaps="false"
            android:textColor="#EEF7FF"
            android:textSize="17sp" />

    </LinearLayout>

</org.lineageos.setupwizard.widget.TouchRippleLayout>
