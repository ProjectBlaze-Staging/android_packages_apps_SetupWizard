<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/setup_wizard_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ameos_sky_canvas"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="56dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <!-- 96dp 3D Hero Icon (Figma 4:1241) -->
    <ImageView
        android:id="@+id/terms_hero_icon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/ameos_terms_hero" />

    <!-- Title: Terms & Services -->
    <TextView
        android:id="@+id/terms_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="-0.02"
        android:text="Terms &amp; Services"
        android:textColor="#203A51"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Subtitle: By using BlazeAOSP, you agree to the following system terms: -->
    <TextView
        android:id="@+id/terms_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="By using BlazeAOSP, you agree to the following system terms:"
        android:textColor="#5B7894"
        android:textSize="14sp" />

    <!-- 29dp-radius #F7FCFF Frosted Card containing BlazeAOSP Terms & Privacy Toggles -->
    <FrameLayout
        android:id="@+id/page"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="14dp"
        android:layout_weight="1"
        android:background="@drawable/ameos_frosted_card"
        android:elevation="2dp"
        android:padding="18dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. BlazeAOSP Open-Source License & System Integrity -->
                <TextView
                    android:id="@+id/ameos_attribution_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="1. BlazeAOSP System License &amp; Integrity"
                    android:textColor="#203A51"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ameos_attribution_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="3dp"
                    android:text="BlazeAOSP is an open-source mobile operating system built on the Android Open Source Project (AOSP) and LineageOS under the Apache 2.0 and GPLv2 licenses. System modifications, custom kernels, and root access are operated at the user's own responsibility."
                    android:textColor="#3B556D"
                    android:textSize="12.5sp" />

                <!-- 2. Local Privacy & Security Guarantee -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="2. On-Device Privacy &amp; Data Protection"
                    android:textColor="#203A51"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Your biometric credentials, offline Blaze Account profile, Dynamic Island preferences, and BlazeHouse customizations are stored strictly on your device and are never transmitted to external servers without your consent."
                    android:textColor="#3B556D"
                    android:textSize="12.5sp" />

                <!-- 3. System Privacy & Diagnostics -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="3. System Diagnostics &amp; Controls"
                    android:textColor="#203A51"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <!-- Metrics Row -->
                <LinearLayout
                    android:id="@+id/metrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <CheckBox
                        android:id="@+id/enable_metrics_checkbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#017CFE"
                        android:clickable="false"
                        android:duplicateParentState="true" />

                    <TextView
                        android:id="@+id/enable_metrics_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/services_metrics_label"
                        android:textColor="#3B556D"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- On-screen Nav Keys Row -->
                <LinearLayout
                    android:id="@+id/nav_keys"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <CheckBox
                        android:id="@+id/nav_keys_checkbox"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#017CFE"
                        android:clickable="false"
                        android:duplicateParentState="true" />

                    <TextView
                        android:id="@+id/nav_keys_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/services_os_nav_keys_label"
                        android:textColor="#3B556D"
                        android:textSize="12.5sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- I accept the Rules, Terms & Services Checkbox Pill Row (Figma 4:1241) -->
    <LinearLayout
        android:id="@+id/accept_terms_row"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/ameos_frosted_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <CheckBox
            android:id="@+id/accept_terms_checkbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#017CFE"
            android:checked="true"
            android:clickable="false"
            android:duplicateParentState="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="I accept the Rules, Terms &amp; Services"
            android:textColor="#203A51"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Bar: 44dp circular back button + bottom-right #60A5FF -> #4781FF filled pill button "I agree" -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="52dp">

        <ImageButton
            android:id="@+id/terms_back_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/ameos_btn_back_circle"
            android:contentDescription="Back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_chevron_left_24dp"
            android:tint="#203A51" />

        <Button
            android:id="@+id/terms_agree_button"
            android:layout_width="168dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/ameos_btn_pill_filled"
            android:fontFamily="sans-serif-medium"
            android:text="I agree"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </RelativeLayout>

</LinearLayout>
